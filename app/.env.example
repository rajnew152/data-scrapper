# Copy this file to .env and fill in real values. Never commit .env.

# Serper.dev API key (required for live collection)
SERPER_API_KEY=

# Optional shared access code. When set, every API request must send it in
# the X-Auth-Token header (the web page prompts for it once). Strongly
# recommended when the app is reachable beyond this machine.
APP_AUTH_TOKEN=

# Optional: comma-separated CORS origins for a production domain
# (defaults to localhost origins; never use *)
APP_ALLOWED_ORIGINS=

# Optional: set to 1 once the app is served over HTTPS (enables HSTS header)
APP_FORCE_HTTPS=

# Optional performance tuning (sensible defaults; ranges enforced)
SCRAPER_CONCURRENCY=      # max crawl threads of ONE job (default 48, 4-100)
SERPER_CONCURRENCY=       # Serper requests in flight, whole account, shared by all jobs (default 6, 1-16)
SERPER_RPS=               # Serper requests/sec ceiling for the account, adaptive (default 8, 1-50)
SEARCH_PREFETCH=          # queries searched ahead of the crawl (default 3, 1-8)
MAX_CONNECTIONS=          # HTTP pool size (default 100, 16-200)
KEEPALIVE_CONNECTIONS=    # kept-alive pools (default 100, 16-200)
EXPORT_MIN_INTERVAL=      # seconds between mid-run Excel refreshes (default 30; 60 on a small host). Unchanged files are never rewritten
STATUS_PUBLISH_INTERVAL=  # seconds between worker status updates (default 0.5; 1 on a small host)
ROBOTS_CACHE_HOSTS=       # robots.txt answers kept in memory (default 20000; 2000 on a small host)
FETCH_CONNECT_TIMEOUT=    # page fetch connect timeout, s (default 5)
FETCH_READ_TIMEOUT=       # page fetch read timeout, s (default 12)
FETCH_DEADLINE=           # total seconds per page incl. slow bodies (default 25)
ROBOTS_CONNECT_TIMEOUT=   # robots.txt probe connect timeout, s (default 4); failure = host skipped as dead
ROBOTS_READ_TIMEOUT=      # robots.txt probe read timeout, s (default 8)
SERPER_CONNECT_TIMEOUT=   # Serper connect timeout, s (default 5)
SERPER_READ_TIMEOUT=      # Serper read timeout, s (default 30; Places can take ~16 s)
POLL_MS_ACTIVE=           # browser status poll while a collection runs, ms (default 3000)
POLL_MS_IDLE=             # browser status poll otherwise, ms (default 10000)

# Multi-user scheduling (every browser/user runs its own collection)
MAX_ACTIVE_JOBS=          # collections running at the same time (default 4; 3 on a small host, 1-32); more wait in a queue
MAX_QUEUED_JOBS=          # collections allowed to wait (default 500)
MAX_JOBS_PER_CLIENT=      # queued + running collections per user (default 1)
GLOBAL_CRAWL_WORKERS=     # crawl threads across all running jobs (default 192; 48 on a small host); a job takes what is free, at least an equal slice
ANALYZE_PROCESSES=        # HTML-parsing processes shared by all jobs (default: CPU cores - 2, max 8; 0 on a small host)
ANALYZE_THREADS=          # with ANALYZE_PROCESSES=0: pages parsed at once in the crawl threads (default: CPUs, min 1)

# API protection (per user = per browser; the IP ceiling only stops floods)
RATE_LIMIT_CLIENT_PER_MIN=   # API requests per user per minute (default 240)
RATE_LIMIT_COLLECT_PER_MIN=  # collection starts per user per minute (default 10)
RATE_LIMIT_IP_PER_MIN=       # requests per IP address per minute (default 60000)
HTTP_LIMIT_CONCURRENCY=      # open requests before the server answers 503 (default 6000)
FORWARDED_ALLOW_IPS=         # behind a reverse proxy: the proxy's IP, so real client IPs are used
APP_OUTPUT_DIR=              # data folder (default app/output)
